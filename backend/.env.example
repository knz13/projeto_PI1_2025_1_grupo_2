# Backend Environment Configuration
# Copy this file to .env and update the values for your environment

# Server Configuration
NODE_ENV=development
PORT=4852
HOST=0.0.0.0

# Supabase Configuration
# Get these values from your Supabase project settings
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# CORS Configuration
# Allowed origins for CORS (use "*" for allow all, or specific URLs)
CORS_ORIGIN=*

# File Upload Configuration
# Maximum file size in bytes (default: 500MB = 524288000)
MAX_FILE_SIZE=524288000

# Body Parser Configuration
# Maximum request body size (default: 500mb)
MAX_BODY_SIZE=500mb

# WebSocket Configuration
# WebSocket endpoint path
WS_PATH=/ws

# WebSocket logging (true/false, auto-enabled in development)
WS_LOGGING=true

# Git Branch for Auto-Updates (used by docker)
GIT_BRANCH=main

# Docker-specific Environment Variables
# These are used when running in Docker containers
PYTHONUNBUFFERED=1
PYTHONIOENCODING=utf-8
GIT_DISCOVERY_ACROSS_FILESYSTEM=1
