# Arquivo de exemplo de variáveis de ambiente para o backend
# Copie este arquivo para .env e preencha com os valores corretos

# Configurações do servidor
NODE_ENV=production
PORT=5875

# Configurações do Supabase
SUPABASE_URL=sua_url_do_supabase
SUPABASE_ANON_KEY=sua_chave_anonima_do_supabase
SUPABASE_SERVICE_ROLE_KEY=sua_chave_service_role_do_supabase

# Configurações JWT
JWT_SECRET=seu_jwt_secret_muito_seguro

# Configurações do Stripe (se usando)
STRIPE_SECRET_KEY=sua_chave_secreta_do_stripe
STRIPE_PUBLISHABLE_KEY=sua_chave_publica_do_stripe

# Configurações OpenAI (se usando)
OPENAI_API_KEY=sua_chave_api_openai

# Outras configurações específicas do seu projeto
# Adicione outras variáveis conforme necessário
